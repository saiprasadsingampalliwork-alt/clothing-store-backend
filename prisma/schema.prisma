generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  blocked      Boolean  @default(false)
  addresses    Json     @default("[]")
  cart                Json      @default("[]")
  wishlist            Json      @default("[]")
  cartUpdatedAt       DateTime?
  wishlistUpdatedAt   DateTime?
  // Bag and wishlist reminders are marketing messages: sent only after the customer opts in, and stopped by "STOP".
  whatsappOptIn       Boolean   @default(false)
  whatsappOptInAt     DateTime?
  cartRemindedKey     String    @default("")
  wishlistRemindedKey String    @default("")
  createdAt           DateTime  @default(now())
  orders       Order[]
}

model Category {
  slug  String @id
  label String
  blurb String @default("")
  image String @default("")
  chart String @default("upper")
  sort  Int    @default(0)
}

// Who a product is for: Women, Men, Girls, Baby, and so on. Product.gender holds the audience slug.
// A shared audience (Unisex, Kids unisex) shows under every audience in the same group.
model Audience {
  slug   String  @id
  label  String
  group  String  @default("adults")
  shared Boolean @default(false)
  sizes  Json
  active Boolean @default(true)
  sort   Int     @default(0)
}

// Materials staff pick from on products. Product.fabric holds the label; Product.fabricDetail the weight, like "160 gsm".
model Fabric {
  slug  String @id
  label String @unique
}

// Occasions or looks (Casual, Formal, Ethnic…) that cut across categories and audiences.
// Product.styles holds style slugs, so renaming a style never touches products.
model Style {
  slug   String  @id
  label  String  @unique
  active Boolean @default(true)
  sort   Int     @default(0)
}

model Product {
  slug            String  @id
  name            String
  price           Int
  category        String
  gender          String  @default("unisex")
  fabric          String
  fabricDetail    String  @default("")
  styles          String[] @default([])
  description     String
  details         Json
  care            Json
  rating          Float
  reviewCount     Int
  isNew           Boolean @default(false)
  reviews         Json
  colors          Json
  sizes           Json
  stock           Json
  status          String  @default("active")
  salePrice       Int?
  saleStart       String  @default("")
  saleEnd         String  @default("")
  metaTitle       String  @default("")
  metaDescription String  @default("")
  silhouette      String  @default("tee")
  origin          String  @default("")
  fit             String  @default("")
  model           Json    @default("{\"heightCm\":178,\"size\":\"M\"}")
  photos          Json    @default("[]")
}

model Order {
  id            String    @id
  number        String    @unique
  createdAt     DateTime  @default(now())
  email         String
  phone         String
  address       Json
  items         Json
  delivery      String
  payment       String
  subtotal      Int
  discount      Int
  shipping      Int
  codFee        Int
  total         Int
  coupon        String?
  status        String
  timeline      Json
  notes         String    @default("")
  trackingUrl   String?
  shipment      Json?
  returnRequest     Json?
  razorpayOrderId   String?
  razorpayPaymentId String?
  // cod, paid (charged by Razorpay), demo (online order with no charge), or free (nothing to charge).
  paymentStatus     String    @default("")
  // "", pending, refunded, or failed. A refund is only ever started once per order.
  refundStatus      String    @default("")
  refundId          String?
  refundNote        String    @default("")
  // Lets a guest open, cancel, or return their own order without an account.
  accessKey         String    @default("")
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
}

model PaymentCheckout {
  id              String    @id @default(cuid())
  razorpayOrderId String    @unique
  amountPaise     Int
  payload         Json
  paymentId       String?
  orderId         String?
  usedAt          DateTime?
  // Set when a verified payment could not become an order; the payment is then refunded.
  failedReason    String?
  refundId        String?
  refundStatus    String?
  createdAt       DateTime  @default(now())
}

model Coupon {
  code       String  @id
  type       String
  value      Int
  minOrder   Int
  usageLimit Int
  used       Int     @default(0)
  starts     String  @default("")
  ends       String  @default("")
  active     Boolean @default(true)
}

model Banner {
  id       String @id
  title    String
  subtitle String @default("")
  href     String @default("/shop")
  starts   String @default("")
  ends     String @default("")
}

model Staff {
  id           String @id
  name         String
  email        String @unique
  passwordHash String
  role         String
}

model Setting {
  id   String @id
  data Json
}

model Sequence {
  id    String @id
  value Int
}

model RestockAlert {
  id        String    @id @default(cuid())
  slug      String
  color     String
  size      String
  contact   String
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([slug, color, size, contact])
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  purpose   String    @default("reset")
  createdAt DateTime  @default(now())
}
