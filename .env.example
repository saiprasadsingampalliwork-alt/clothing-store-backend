DATABASE_URL="postgresql://USER@localhost:5432/earthen?schema=public"
PORT=4000
TOKEN_SECRET="replace-me"
APP_URL="http://localhost:3000"
# Comma-separated extra origins allowed by CORS (preview deployments, etc).
CORS_ORIGINS=

# Filled in when the studio mailbox is ready. Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Earthen <hello@earthen.in>"

# Filled in when the WhatsApp Business account is ready. Leave WHATSAPP_TOKEN empty to skip sending.
# Templates are utility messages in English (en). Create them in WhatsApp Manager before a live phone can receive them:
# earthen_order_confirmed — Hi {{1}}, your Earthen order {{2}} is confirmed. {{3}} Total {{4}}. {{5}}.
# earthen_order_packed — Hi {{1}}, your Earthen order {{2}} is packed and will leave the studio in Bengaluru shortly.
# earthen_order_shipped — Hi {{1}}, your Earthen order {{2}} has shipped with {{3}}. Tracking number {{4}}.
# earthen_order_out — Hi {{1}}, your Earthen order {{2}} is out for delivery.
# earthen_order_delivered — Hi {{1}}, your Earthen order {{2}} was delivered. You can ask for a return or exchange from your order while the return window is open.
# earthen_order_cancelled — Hi {{1}}, your Earthen order {{2}} was cancelled. {{3}}.
# earthen_return_requested — Hi {{1}}, we have your return request for Earthen order {{2}}. We will write again when it is decided.
# earthen_return_approved — Hi {{1}}, your return for Earthen order {{2}} was approved. The refund goes back to the original payment method.
# earthen_exchange_approved — Hi {{1}}, your exchange for Earthen order {{2}} was approved. We will send the replacement from the studio.
# earthen_return_declined — Hi {{1}}, your return for Earthen order {{2}} was declined. The order stays with you. Write to hello@earthen.in if this is a mistake.
# earthen_order_returned — Hi {{1}}, your Earthen order {{2}} was marked returned.
# earthen_password_otp — Your Earthen password code is {{1}}. It expires in 10 minutes. If you did not ask for it, you can ignore this message.
# earthen_sign_in_otp — Your Earthen sign-in code is {{1}}. It expires in 10 minutes. If you did not ask for it, you can ignore this message.
# earthen_cart_waiting — Hi {{1}}, you still have {{2}} in your Earthen bag. Total {{3}}. Checkout when you are ready.
# earthen_wishlist_waiting — Hi {{1}}, {{2}} is still on your Earthen wishlist. You have not ordered these yet.
# Signed-in customers are reminded once, WHATSAPP_NUDGE_MINUTES after the bag or wishlist last changed. Default 60.
WHATSAPP_NUDGE_MINUTES=60
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# Meta App credentials for Webhook verification and Coexistence (inbound messages, mobile app echoes, and lifecycle events).
# Callback URL to configure in Meta Dashboard: https://your-domain.com/v1/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Must match the language your WhatsApp templates were approved in, exactly (en, en_US, en_GB…).
WHATSAPP_TEMPLATE_LANGUAGE=en

# Customer WhatsApp replies and "WhatsApp is disconnected" alerts are emailed here. Needs SMTP above.
STUDIO_INBOX_EMAIL=
# With coexistence the studio already sees replies in the WhatsApp Business app; set to false to stop emailing them.
WHATSAPP_FORWARD_REPLIES=true

# With email or WhatsApp not set up, MESSAGES_DEMO=true shows sign-in codes and reset links ON SCREEN for demos.
# Never on a live store: anyone could sign in as any customer. Off, phone sign-in waits for WhatsApp to be set up.
MESSAGES_DEMO=false

# Filled in when the Razorpay account is ready. Leave RAZORPAY_KEY_ID empty to skip charging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# With no Razorpay keys, online payment is switched off and checkout offers cash on delivery only.
# Set PAYMENTS_DEMO=true to let UPI, card, and net banking orders complete WITHOUT any charge, for demos.
# Never set it on a live store. Demo orders are labelled "Demo, not charged" in the admin.
PAYMENTS_DEMO=false

# Behind a load balancer or reverse proxy (Nginx, Render, Railway…), set to the number of proxies, usually 1,
# so rate limits see each shopper's own IP instead of the proxy's.
# TRUST_PROXY=1

# Where uploaded product photos are stored (default: server/uploads). Back this folder up.
# UPLOAD_DIR=/var/earthen/uploads

# "Use my current location" uses OpenStreetMap, whose policy asks apps to identify themselves. An email or the shop URL.
NOMINATIM_CONTACT=

# Photos on Cloudinary (needed on Render free, which has no lasting disk): the "API environment variable"
# from the Cloudinary dashboard. Without it, photos are saved to uploads/.
CLOUDINARY_URL=

# How often to check for due bag and wishlist reminders, in minutes (each check is one database query).
NUDGE_CHECK_MINUTES=10
